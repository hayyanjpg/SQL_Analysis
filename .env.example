# Salin file ini menjadi .env lalu isi dengan nilai sebenarnya.
# JANGAN commit .env — file tersebut sudah dikecualikan oleh .gitignore.

# DSN PostgreSQL. Untuk database cloud biasanya perlu sslmode=require.
DATABASE_URL="postgresql://user:password@localhost:5432/sql_analysis?sslmode=require"

# API key Google Gemini (Google AI Studio).
GEMINI_API_KEY="your-google-ai-studio-key"

# Opsional. Default di kode: gemini-3.5-flash.
GEMINI_MODEL="gemini-3.5-flash"

# Opsional. Origin frontend yang diizinkan, dipisahkan koma.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
