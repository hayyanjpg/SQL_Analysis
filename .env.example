# Salin file ini menjadi .env lalu isi dengan nilai sebenarnya.
# JANGAN commit .env — file tersebut sudah dikecualikan oleh .gitignore.

# DSN PostgreSQL. Untuk database cloud biasanya perlu sslmode=require.
DATABASE_URL="postgresql://user:password@localhost:5432/sql_analysis?sslmode=require"

# API key Google Gemini (Google AI Studio).
GEMINI_API_KEY="your-google-ai-studio-key"

# Opsional. Default di kode: gemini-3.5-flash.
GEMINI_MODEL="gemini-3.5-flash"

# Opsional. Origin frontend yang diizinkan, dipisahkan koma.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# WAJIB untuk deployment publik. Kunci akses bersama yang harus dimasukkan
# pengguna di frontend. Kosongkan hanya untuk pengembangan lokal.
# Buat kunci acak: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_ACCESS_KEY="ganti-dengan-kunci-acak-panjang"

# Opsional, HANYA untuk pengembangan lokal. Jika API_ACCESS_KEY kosong,
# set ini ke 1 agar endpoint data boleh memakai schema public tanpa login.
# Jangan pernah diaktifkan di produksi.
# ALLOW_ANONYMOUS_LEGACY="1"

# Login Supabase (wajib untuk multi-user).
SUPABASE_URL="https://PROJECT-ANDA.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_xxx"

# Opsional. Batas upload CSV/Excel dalam MB (default 10; Render free 512 MB).
MAX_UPLOAD_MB="10"

# Opsional. Batas file .sql dalam MB (default 5). Di Vercel set 4.
MAX_SQL_MB="5"

# Opsional. Rate limit per IP (jumlah request / jendela waktu).
RATE_LIMIT_ASK_PER_MINUTE="20"
RATE_LIMIT_UPLOAD_PER_10_MINUTES="10"
RATE_LIMIT_EXECUTE_PER_MINUTE="10"
