# Opsional. Default di kode sudah http://127.0.0.1:8000
# Base URL backend tanpa path /api/...
VITE_API_BASE_URL=http://127.0.0.1:8000

# Kompatibilitas lama (boleh berisi URL lengkap /api/ask):
# VITE_API_URL=http://127.0.0.1:8000/api/ask

# Opsional. Samakan dengan batas backend.
# Vercel Functions membatasi badan request 4.5 MB -> gunakan 4.
VITE_MAX_UPLOAD_MB=10
VITE_MAX_SQL_MB=5
