# Opsional. Default di kode sudah http://127.0.0.1:8000
# Base URL backend tanpa path /api/...
VITE_API_BASE_URL=http://127.0.0.1:8000

# Kompatibilitas lama (boleh berisi URL lengkap /api/ask):
# VITE_API_URL=http://127.0.0.1:8000/api/ask

# Opsional. Samakan dengan batas backend.
# Vercel Functions membatasi badan request 4.5 MB -> gunakan 4.
VITE_MAX_UPLOAD_MB=10
VITE_MAX_SQL_MB=5

# Wajib untuk login multi-user. Isi dengan alamat project Supabase dan
# publishable/anon key (bukan service role key).
# Tanpa dua nilai ini, aplikasi berjalan dalam mode kunci akses bersama.
VITE_SUPABASE_URL=https://PROJECT-ANDA.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
